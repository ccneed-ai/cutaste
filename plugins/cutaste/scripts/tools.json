{"tools":[{"name":"cutaste_status","description":"队列、后台任务与现有历史摘要，只返回已有汇总；不扫描会话、不调用模型、不返回原话。Status and cached history counts only.","inputSchema":{"type":"object","properties":{}},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"cutaste_alignment","description":"对齐当前项目待办：action=read只读；ask绑定问题id/version返回token和问题短ID；answer引用随后同宿主实际捕获的完整用户原话，提交clarify/reject/defer。无可信会话绑定时原话必须含短ID。解释须受原话支持；过期/跨项目/伪造回复拒绝。目标澄清仍须重新改写及运行验证，不生成盲票或确认回执。","inputSchema":{"type":"object","properties":{"trigger":{"default":"manual","type":"string","enum":["related-task","session-start","idle","manual"]},"project":{"type":"string","minLength":1,"maxLength":1000},"pageType":{"type":"string","minLength":1,"maxLength":200},"scenario":{"type":"string","minLength":1,"maxLength":200},"limit":{"default":1,"type":"integer","minimum":1,"maximum":3},"language":{"default":"zh","type":"string","enum":["zh","en"]},"action":{"default":"read","type":"string","enum":["read","ask","answer"]},"question":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":300},"version":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}},"required":["id","version"],"additionalProperties":false},"token":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"response":{"type":"object","properties":{"text":{"type":"string","minLength":1,"maxLength":16000},"evidenceId":{"type":"string","minLength":1,"maxLength":200},"decision":{"type":"string","enum":["clarify","reject","defer"]},"scope":{"type":"object","properties":{"projects":{"maxItems":8,"type":"array","items":{"type":"string","minLength":1}},"pageTypes":{"maxItems":8,"type":"array","items":{"type":"string","minLength":1}},"scenarios":{"maxItems":8,"type":"array","items":{"type":"string","minLength":1}}},"additional